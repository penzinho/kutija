---
import { Picture } from 'astro:assets';
import AwardBadge from './AwardBadge.astro';
import type { Entry } from '../data/entries';
import { getRank } from '../data/ranks';
import { coverImage, imageAlt, IMAGE_PRESETS } from '../data/images';

interface Props {
  /** Exactly 8 entries; the first one starts in front. */
  entries: readonly Entry[];
}

const { entries } = Astro.props;
---

{/*
  Decorative: every entry here is also in the grid below, so the stack is hidden from
  assistive tech and out of the tab order. No transition:name, the grid card owns it
  (a duplicate name would abort the view transition).
*/}
<div class="stack" data-hero-stack aria-hidden="true">
  <div class="inner" data-stack-inner>
    {
      entries.map((e, k) => {
        const img = coverImage(e);
        const rank = getRank(e.id);
        return (
          <a href={`/rad/${e.id}`} class="card" data-slot={k} tabindex="-1">
            {img ? (
              <Picture src={img} alt={imageAlt(e)} loading={k === 0 ? 'eager' : 'lazy'} {...IMAGE_PRESETS.hero} />
            ) : (
              <div class="missing" />
            )}
            <div class="sheen" />
            <div class="top">
              <span class="code">{e.code}</span>
              {e.award !== null && <AwardBadge award={e.award} short />}
            </div>
            <div class="bottom">
              <div>
                <div class="label">Rad</div>
                <div class="num">{String(e.id).padStart(2, '0')}</div>
              </div>
              {rank && <span class="rank">Građani #{rank.rank}</span>}
            </div>
          </a>
        );
      })
    }
  </div>
</div>

<style>
  .stack {
    position: relative;
    width: min(100%, 480px);
    aspect-ratio: 1 / 1;
    margin: 0 auto;
    perspective: 1400px;
  }
  .inner {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transition: transform 700ms var(--ease-out);
  }

  .card {
    --rot: rotateY(-16deg) rotateX(4deg);
    position: absolute;
    left: 4%;
    top: 13%;
    width: 70%;
    aspect-ratio: 4 / 5;
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--sh-lift);
    color: var(--c-ink);
    backface-visibility: hidden;
    transition:
      transform var(--dur-hero) var(--ease-out),
      opacity 700ms var(--ease-out);
  }
  .card:hover {
    color: var(--c-ink);
  }
  /* Slots: 0 = front, 1–3 fading back, 4–6 parked out of sight, 7 = just exited left. */
  .card[data-slot='0'] { transform: translate3d(0, 0, 0) var(--rot) rotateZ(-2deg); opacity: 1; z-index: 10; }
  .card[data-slot='1'] { transform: translate3d(9%, -6%, -90px) var(--rot) rotateZ(1deg); opacity: .8; z-index: 9; }
  .card[data-slot='2'] { transform: translate3d(18%, -12%, -180px) var(--rot) rotateZ(3deg); opacity: .5; z-index: 8; }
  .card[data-slot='3'] { transform: translate3d(27%, -18%, -270px) var(--rot) rotateZ(5deg); opacity: .25; z-index: 7; }
  .card[data-slot='4'],
  .card[data-slot='5'],
  .card[data-slot='6'] { transform: translate3d(36%, -24%, -360px) var(--rot) rotateZ(7deg); opacity: 0; z-index: 6; pointer-events: none; }
  .card[data-slot='7'] { transform: translate3d(-80%, 8%, 120px) rotateY(-30deg) rotateZ(-12deg); opacity: 0; z-index: 11; pointer-events: none; }

  .card :global(picture),
  .card :global(img),
  .missing {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .missing {
    background: var(--c-img-missing);
  }
  .sheen {
    position: absolute;
    inset: 0;
    background: var(--c-hero-card-sheen);
  }

  .top {
    position: absolute;
    top: var(--sp-4);
    left: var(--sp-4);
    right: var(--sp-4);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--sp-2);
  }
  .code {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: .1em;
    padding: 5px 8px;
    border-radius: var(--r-xs);
    background: var(--c-chip-dark);
  }
  .bottom {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 14px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--sp-2);
  }
  .label {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: .14em;
    color: var(--c-ink-2);
    text-transform: uppercase;
  }
  .num {
    font-family: var(--font-display);
    font-size: clamp(80px, 11vw, 128px);
    line-height: .82;
  }
  .rank {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    padding: 6px 9px;
    border-radius: var(--r-pill);
    border: 1px solid var(--c-line-strong);
    background: var(--c-chip-dark);
    white-space: nowrap;
  }
</style>

<script>
  import { reducedMotion } from '../lib/motion';

  // Cycle every 3.2 s (front card exits left) and follow the pointer with a small parallax.
  // Off with reduced motion or the calm toggle; paused while the tab is hidden or the
  // pointer is over the stack (so a card doesn't move away under a click).
  const STEP_MS = 3200;

  let timer: number | undefined;

  document.addEventListener('astro:page-load', () => {
    clearInterval(timer);
    const stack = document.querySelector<HTMLElement>('[data-hero-stack]');
    if (!stack || reducedMotion()) return;
    const cards = [...stack.querySelectorAll<HTMLElement>('[data-slot]')];
    const inner = stack.querySelector<HTMLElement>('[data-stack-inner]')!;
    const hero = stack.closest<HTMLElement>('[data-hero]') ?? stack;
    let idx = 0;
    let hovering = false;

    timer = window.setInterval(() => {
      if (!stack.isConnected) return clearInterval(timer);
      if (document.hidden || hovering) return;
      idx = (idx + 1) % cards.length;
      cards.forEach((c, k) => (c.dataset.slot = String((k - idx + cards.length) % cards.length)));
    }, STEP_MS);

    stack.addEventListener('pointerenter', () => (hovering = true));
    stack.addEventListener('pointerleave', () => (hovering = false));

    if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    hero.addEventListener('pointermove', (ev) => {
      const r = hero.getBoundingClientRect();
      const x = (ev.clientX - r.left) / r.width - 0.5;
      const y = (ev.clientY - r.top) / r.height - 0.5;
      inner.style.transform = `rotateY(${(x * 14).toFixed(2)}deg) rotateX(${(-y * 10).toFixed(2)}deg)`;
    });
  });
</script>
