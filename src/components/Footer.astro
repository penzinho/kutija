---
import { meta } from '../data/entries';
import type { NavItem } from '../lib/nav';

interface Props {
  nav: NavItem[];
}

const { nav } = Astro.props;
// Reopens the analytics consent banner (ConsentBanner.astro); only exists with GA configured.
const analytics = /^G-[A-Z0-9]+$/.test(import.meta.env.PUBLIC_GA_ID ?? '');
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-about">
      <span class="footer-name">Naš Dom</span>
      <p class="footer-note">
        Neslužbena stranica. Autorska prava na radove pripadaju autorima.{' '}
        <a href={meta.sourceUrl} target="_blank" rel="noopener">Izvor: službena objava natječaja ↗</a>
      </p>
    </div>
    <nav class="footer-nav" aria-label="Podnožje">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      <a href="/brojke">Brojke i šifre</a>
      {
        analytics && (
          <button type="button" class="footer-link" data-consent-open hidden>
            Kolačići
          </button>
        )
      }
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--c-line);
    margin-top: var(--sp-5);
  }
  .footer-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 32px var(--gutter) 40px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px 40px;
  }
  .footer-about {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    max-width: 560px;
  }
  .footer-name {
    font-family: var(--font-display);
    font-size: 24px;
    text-transform: uppercase;
  }
  .footer-note {
    margin: 0;
    font-size: var(--fs-small);
    color: var(--c-ink-2);
    line-height: 1.5;
  }
  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) 22px;
    font-size: var(--fs-small);
  }
  .footer-nav a,
  .footer-link {
    color: var(--c-ink-2);
  }
  .footer-link {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }
  .footer-link[hidden] {
    display: none;
  }
  .footer-nav a:hover,
  .footer-link:hover {
    color: var(--c-ink);
  }
</style>
