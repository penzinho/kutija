---
// Flip-digit reel, rendered on the server so it shows the right value without JS.
// Markup and styles are shared with the browser updater (src/lib/reel.ts, global.css).
import { reelHtml } from '../lib/reel';

interface Props {
  value: number;
  /** Extra attributes for live updates, e.g. data-counter or data-live. */
  [attr: `data-${string}`]: string | number | undefined;
}

const { value, ...attrs } = Astro.props;
---

<span class="nm-reel" data-reel={value} {...attrs} set:html={reelHtml(value)} />
