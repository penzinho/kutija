---
// "Moj top 3" for shared links (/?top=12,5,40). The page is static, so a script fills
// the block from the query string, cloning pictures from the grid cards already on the page.
interface Props {
  /** id of the grid holding the EntryCards (data-id / data-code). */
  grid: string;
}

const { grid } = Astro.props;
---

<section class="top3" data-top3 data-grid-id={grid} aria-labelledby="top3-title" hidden>
  <div class="inner">
    <div class="intro">
      <div class="kicker"><span class="star" aria-hidden="true">✶</span>Podijeljeni izbor</div>
      <h2 id="top3-title" class="title">Moj<br />top 3</h2>
      <p class="lead">Žiri je odlučio. Ja sam glasao. A ti?</p>
      <a class="cta" href="/dvoboj">Složi svoj top 3 <span aria-hidden="true">→</span></a>
    </div>
    <ol class="list" data-top3-list></ol>
  </div>
  <template data-top3-row>
    <li>
      <a class="row">
        <span class="place"></span>
        <span class="thumb"></span>
        <span class="name"><span class="rad"></span><span class="code"></span></span>
      </a>
    </li>
  </template>
</section>

<style>
  .top3 {
    position: relative;
    overflow: hidden;
    background: var(--c-top3-bg);
    border-bottom: 1px solid var(--c-line);
  }
  .inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: clamp(32px, 5vw, 64px) var(--gutter);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    gap: clamp(28px, 4vw, 48px);
    align-items: center;
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
    color: var(--c-ink-2);
  }
  .star {
    color: var(--c-accent);
  }
  .title {
    margin: var(--sp-4) 0 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--fs-display-l);
    line-height: var(--lh-display);
    text-transform: uppercase;
  }
  .lead {
    margin: var(--sp-4) 0 0;
    font-size: var(--fs-body-l);
    color: var(--c-ink-2);
  }
  .cta {
    display: inline-flex;
    gap: 10px;
    margin-top: var(--sp-5);
    padding: 14px 22px;
    border-radius: var(--r-pill);
    background: var(--c-accent);
    color: var(--c-on-accent);
    font-weight: 700;
    transition:
      box-shadow var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .cta:hover {
    box-shadow: var(--sh-cta);
    transform: translateY(-2px);
    color: var(--c-on-accent);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }
  .list :global(.row) {
    display: grid;
    grid-template-columns: clamp(36px, 5vw, 56px) clamp(96px, 14vw, 150px) minmax(0, 1fr);
    align-items: center;
    gap: clamp(12px, 2vw, 22px);
    padding: 10px;
    border-radius: var(--r-md);
    background: var(--c-top3-row);
    border: 1px solid var(--c-top3-row-bd);
    color: var(--c-ink);
    transition:
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .list :global(.row:hover) {
    color: var(--c-ink);
    transform: translateY(-2px);
    box-shadow: var(--sh-card-hover);
  }
  .list :global(.place) {
    font-family: var(--font-display);
    font-size: clamp(44px, 6vw, 72px);
    line-height: .9;
    text-align: center;
  }
  .list :global(li:first-child .place) {
    color: var(--c-accent);
  }
  .list :global(.thumb) {
    aspect-ratio: 16 / 10;
    border-radius: var(--r-sm);
    overflow: hidden;
    background: var(--c-img-missing);
  }
  .list :global(.thumb picture),
  .list :global(.thumb img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .list :global(.rad) {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(26px, 3.2vw, 40px);
    line-height: 1;
    text-transform: uppercase;
  }
  .list :global(.code) {
    display: block;
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--c-ink-3);
  }
</style>

<script>
  const MAX = 3;

  document.addEventListener('astro:page-load', () => {
    const block = document.querySelector<HTMLElement>('[data-top3]');
    if (!block) return;
    const grid = document.getElementById(block.dataset.gridId!);
    const tpl = block.querySelector<HTMLTemplateElement>('[data-top3-row]')!;
    const list = block.querySelector<HTMLOListElement>('[data-top3-list]')!;

    // Keep only ids that are on the page, first occurrence wins, at most three.
    const raw = new URLSearchParams(location.search).get('top') ?? '';
    const cards: HTMLElement[] = [];
    for (const part of raw.split(',')) {
      if (!/^\d{1,2}$/.test(part.trim())) continue;
      const card = grid?.querySelector<HTMLElement>(`:scope > [data-id="${Number(part)}"]`);
      if (card && !cards.includes(card)) cards.push(card);
      if (cards.length === MAX) break;
    }
    if (!cards.length) return;

    list.replaceChildren(
      ...cards.map((card, i) => {
        const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
        const id = card.dataset.id!;
        li.querySelector('a')!.href = `/rad/${id}`;
        li.querySelector('.place')!.textContent = String(i + 1);
        li.querySelector('.rad')!.textContent = `Rad ${id.padStart(2, '0')}`;
        li.querySelector('.code')!.textContent = card.dataset.code ?? '';
        const pic = card.querySelector('picture')?.cloneNode(true) as HTMLElement | undefined;
        if (pic) {
          // The row text already names the entry.
          pic.querySelector('img')?.setAttribute('alt', '');
          li.querySelector('.thumb')!.append(pic);
        }
        return li;
      }),
    );
    block.hidden = false;
  });
</script>
