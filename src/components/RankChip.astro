---
import { rankDelta, type RankInfo } from '../lib/rank';

interface Props {
  /** Undefined for entries outside the people's ranking (excluded) or before live data. */
  rank: RankInfo | undefined;
  /** Entry id: the chip then follows live ranks (src/lib/live-dom.ts). Omit for a fixed sample. */
  id?: number;
  /** pill: bordered chip; inline: bare text, as in the card meta row. */
  variant?: 'pill' | 'inline';
}

const { rank, id, variant = 'pill' } = Astro.props;
const delta = rankDelta(rank);
---

<span class:list={['rank-chip', variant]} data-rank-chip={id}>
  <span class="label">Građani</span>
  <span class="rank" data-rc-rank>{rank ? `#${rank.rank}` : '—'}</span>
  <span class="delta" data-rc-delta data-trend={delta.trend} aria-hidden="true" hidden={!rank}>{delta.text}</span>
  <span class="visually-hidden" data-rc-label>{rank ? delta.label : ''}</span>
</span>

<style>
  .rank-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    white-space: nowrap;
  }
  .pill {
    padding: 6px 10px;
    border-radius: var(--r-pill);
    border: 1px solid var(--c-line-strong);
  }
  .inline {
    font-size: var(--fs-micro);
  }
  .inline .label {
    color: var(--c-ink-3);
  }
  .rank {
    font-weight: 500;
  }
  .delta[data-trend='up'] {
    color: var(--c-up);
  }
  .delta[data-trend='down'],
  .delta[data-trend='flat'] {
    color: var(--c-down);
  }
</style>
