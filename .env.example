# Copy to .env for local development. Never commit .env.

# --- Browser (PUBLIC_*, safe to expose; also set in Vercel) ---
# Supabase project URL and anon key (Project Settings -> API).
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=
# Cloudflare Turnstile site key (the invisible widget).
PUBLIC_TURNSTILE_SITE_KEY=

# --- Build (Vercel) ---
# Production URL, used for canonical and OG URLs.
SITE_URL=

# --- Server only: Supabase Edge Function secret, NOT a Vercel variable ---
# Set with: pnpm dlx supabase secrets set IP_HASH_SALT_SECRET=...
# Long random string; the daily ip_hash salt is derived from it.
IP_HASH_SALT_SECRET=
# Optional, comma-separated origins allowed by the function's CORS (unset = any).
# Set with: pnpm dlx supabase secrets set ALLOWED_ORIGINS=https://...,http://localhost:4321
ALLOWED_ORIGINS=

# --- scripts/smoke-vote.ts only ---
# Any token works when the project uses Turnstile's test secret; leave empty if captcha is off.
SMOKE_CAPTCHA_TOKEN=
